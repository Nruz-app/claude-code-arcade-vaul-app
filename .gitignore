# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Capturas y artefactos de sesiones de Playwright.
# El contenido de .playwright-mcp/ se ignora con /* y no excluyendo la carpeta:
# git no puede reincluir un archivo cuyo directorio padre está excluido, y así
# la excepción de .gitkeep sí surte efecto y la carpeta se mantiene versionada.
.playwright-screenshots
.playwright-mcp/*
!.playwright-mcp/.gitkeep

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# El .env.example SÍ se versiona: es la plantilla que dice qué variables hacen
# falta. Las dos líneas van en este orden a propósito — la reinclusión tiene que
# ir después del patrón que la excluye, o no surte efecto.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (configuración personal, no del equipo)
.claude/settings.local.json

# volcado que deja Git Bash al caerse; no es del proyecto
bash.exe.stackdump

# CLI de Supabase: lo genera `supabase link` y es local de cada máquina.
# config.toml lleva dentro el project_ref, y versionarlo lo pondría en un cuarto
# archivo — el runbook (supabase/README.md, paso 4) manda `supabase link
# --project-ref` en su lugar justo para que la lista siga siendo de tres.
# Lo que SÍ se versiona de supabase/ es migrations/, schema.sql y README.md.
supabase/config.toml
supabase/.branches/
supabase/.temp/

# Marcador de lectura del bot de Telegram (scripts/telegram-recv.mjs): estado
# local de esta máquina, como el offset de un lector. Versionarlo haría que otra
# copia del repo se saltase mensajes que aquí ya se leyeron.
.telegram-offset.json
