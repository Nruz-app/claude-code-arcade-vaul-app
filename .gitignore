# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Capturas y artefactos de sesiones de Playwright.
# El contenido de .playwright-mcp/ se ignora con /* y no excluyendo la carpeta:
# git no puede reincluir un archivo cuyo directorio padre está excluido, y así
# la excepción de .gitkeep sí surte efecto y la carpeta se mantiene versionada.
.playwright-screenshots
.playwright-mcp/*
!.playwright-mcp/.gitkeep

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (configuración personal, no del equipo)
.claude/settings.local.json

# volcado que deja Git Bash al caerse; no es del proyecto
bash.exe.stackdump
