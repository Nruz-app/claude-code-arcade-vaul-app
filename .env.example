# Copia este archivo como .env y rellena los valores del dashboard de Supabase.
# Si vienes de una mudanza de proyecto, el runbook es supabase/README.md: este
# archivo es uno de los TRES sitios donde vive el project_ref (paso 4).
NEXT_PUBLIC_SUPABASE_URL=https://yrzosefjyiwybtdyquhi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo la necesita el CLI de Supabase; la aplicación no la lee.
SUPABASE_DB_PASS=

# Bot de Telegram — puente local con el móvil (/telegram-arcade-send).
# El token lo da @BotFather y NO se versiona ni se pega en un chat: si se te
# escapa, /revoke en @BotFather y pon aquí el nuevo. El chat id es el tuyo; se
# lo puedes preguntar a @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
